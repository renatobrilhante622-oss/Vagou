DATABASE_URL=postgresql+asyncpg://vagou:vagou@localhost:5432/vagou
REDIS_URL=redis://localhost:6379/0
# Generate separately: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Generate separately: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_KEY=
STORAGE_DIR=/tmp/vagou-storage
ALLOWED_ORIGINS=[]

# Gmail: enable 2-step verification and create an app password in your Google account.
# Fill these values only in backend/.env (ignored by Git), never in this example.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
# SMTP_USER is also accepted; SMTP_FROM defaults to the authenticated user.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT_SECONDS=15

# Verified accounts allowed to approve/reject ads; JSON array of email addresses.
MODERATOR_EMAILS=[]

# Authorized HTTPS JSON feeds; disabled by default. Never place API keys in URLs.
JOB_SOURCE_URLS=[]
JOB_SOURCE_ALLOWED_HOSTS=[]
JOB_SOURCE_AUTO_APPROVE=false
JOB_SOURCE_MAX_BYTES=2097152
JOB_SOURCE_MAX_JOBS=200
AUTOMATION_MAX_APPLICATIONS_PER_RUN=20

# Explicit verified test accounts only; ignored in production.
PREMIUM_TEST_EMAILS=[]
