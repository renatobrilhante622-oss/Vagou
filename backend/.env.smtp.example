SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Explicit testing only. Production never prints verification codes.
APP_ENV=production
DEBUG_VERIFICATION_CODES=false

# Optional allowlist for development/test automation, ignored in production.
PREMIUM_TEST_EMAILS=[]
